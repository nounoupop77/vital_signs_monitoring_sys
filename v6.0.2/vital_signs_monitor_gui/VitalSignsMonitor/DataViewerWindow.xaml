<Window x:Class="VitalSignsMonitor.DataViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:res="clr-namespace:VitalSignsMonitor.Resources"
        Title="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=ViewerTitle}"
        Width="1050" Height="720"
        Background="White"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="ViewerLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Style="{StaticResource ViewerLabel}"
                           Text="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=SelectSignal}"/>
                <ComboBox x:Name="SignalSelector" Width="170" SelectionChanged="SignalSelector_SelectionChanged" VerticalAlignment="Center" HorizontalContentAlignment="Center">
                    <ComboBoxItem Content="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=HeartRateSignal}"/>
                    <ComboBoxItem Content="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=RespRateSignal}"/>
                   
                    <ComboBoxItem Content="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=WaveformSignal}"/>
                    <ComboBoxItem Content="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=FftSignal}"/>
					<ComboBoxItem Content="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=RssiSignal}"/>
                </ComboBox>
                <CheckBox x:Name="ShowPointsCheck" Margin="16,0,0,0" VerticalAlignment="Center"
                          Content="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=ShowPoints}"
                          Checked="ShowPoints_Changed" Unchecked="ShowPoints_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Margin="0,0,6,0"
                        Content="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=SaveFigure}"
                        Click="SaveFigure_Click"/>
                <Button Margin="0,0,6,0"
                        Content="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=ExportData}"
                        Click="ExportData_Click"/>
                <Button
                        Content="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=CloseBtn}"
                        Click="Close_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- main figure -->
        <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8">
            <sp:WpfPlot x:Name="MainPlot"/>
        </Border>

        <!-- point count -->
        <TextBlock Grid.Row="2" x:Name="CountText" Margin="0,0,0,4"
                   Foreground="#6B7280" FontSize="11"
                   Text="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=PointCount}"/>

        <!-- raw data table -->
        <Border Grid.Row="3" BorderBrush="#D1D5DB" BorderThickness="1">
            <DataGrid x:Name="DataGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="All" CanUserAddRows="False"
                      BorderThickness="0" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=ColIndex}"
                                        Binding="{Binding Index}" Width="60"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=ColTimestamp}"
                                        Binding="{Binding Timestamp}" Width="*"/>                    
					
                    <DataGridTextColumn Header="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=ColHr}"
                                        Binding="{Binding HR, StringFormat=F1}" Width="100"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=ColRr}"
                                        Binding="{Binding RR, StringFormat=F1}" Width="100"/>
					<DataGridTextColumn Header="{Binding Source={x:Static res:ResourceExtension.Instance}, Path=ColRssi}"
                                        Binding="{Binding RSSI}" Width="100"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
